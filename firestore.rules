rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Fonction helper : vérifie si l'utilisateur connecté est admin (superadmin ou manager)
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Fonction helper : vérifie si l'utilisateur connecté est superadmin
    function isSuperAdmin() {
      let adminData = get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
      return request.auth != null &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        (!('role' in adminData) || adminData.role == 'superadmin');
    }

    // Collection admins : chaque admin peut lire son propre doc, superadmin peut lire tous les docs
    match /admins/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isSuperAdmin());
      allow write: if false; // Jamais modifiable depuis le client (via API routes + SDK Admin)
    }

    // Règle pour la collection des bots
    match /bots/{botId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Boutique (Store) : Un joueur peut VOIR le catalogue, mais NE DOIT PAS le modifier.
    match /store_catalog/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Règle pour les Rooms de jeu
    match /rooms/{roomId} {
      function isRoomMember() {
        return request.auth != null &&
          (request.auth.uid in resource.data.playerIds || request.auth.uid in request.resource.data.playerIds);
      }

      function onlyPlayerStatusChanged(before, after) {
        return before.id == after.id &&
          after.diff(before).affectedKeys().hasOnly(['status']) &&
          (
            before.status == after.status ||
            (
              before.id == request.auth.uid &&
              before.status != 'BOT' &&
              after.status in ['HUMAN', 'DISCONNECTED', 'SURRENDERED']
            ) ||
            (
              before.id != request.auth.uid &&
              before.status == 'HUMAN' &&
              after.status == 'DISCONNECTED'
            )
          );
      }

      function isPresenceOnlyGameStateUpdate() {
        let before = resource.data.gameState;
        let after = request.resource.data.gameState;
        return before != null && after != null &&
          after.diff(before).affectedKeys().hasOnly(['players']) &&
          before.players.size() == after.players.size() &&
          before.players.size() <= 3 &&
          (before.players.size() < 1 || onlyPlayerStatusChanged(before.players[0], after.players[0])) &&
          (before.players.size() < 2 || onlyPlayerStatusChanged(before.players[1], after.players[1])) &&
          (before.players.size() < 3 || onlyPlayerStatusChanged(before.players[2], after.players[2]));
      }

      // In coordinated rooms, presence is a server decision. A client may only
      // renew its own lease; serverTimestamp resolves to request.time in rules.
      function isOwnHeartbeatRenewal() {
        let beforeHeartbeats = resource.data.get('heartbeats', {});
        let afterHeartbeats = request.resource.data.get('heartbeats', {});
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['heartbeats']) &&
          afterHeartbeats.diff(beforeHeartbeats).affectedKeys().hasOnly([request.auth.uid]) &&
          afterHeartbeats[request.auth.uid] == request.time;
      }

      function isCoordinatorLobbyStart() {
        return resource.data.status == 'WAITING' &&
          resource.data.gameState == null &&
          request.resource.data.status == 'PLAYING' &&
          request.resource.data.gameState != null &&
          request.auth.uid == resource.data.createdBy;
      }

      // Joining a coordinated room is still a client-side lobby operation.
      // Keep the game state server-owned while allowing exactly one new player
      // to be appended before the host starts the match.
      function isCoordinatorLobbyJoin() {
        return resource.data.status == 'WAITING' &&
          request.resource.data.status == 'WAITING' &&
          resource.data.gameState == null &&
          request.resource.data.gameState == null &&
          !(request.auth.uid in resource.data.playerIds) &&
          request.auth.uid in request.resource.data.playerIds &&
          request.resource.data.players.size() == resource.data.players.size() + 1 &&
          request.resource.data.playerIds.size() == resource.data.playerIds.size() + 1;
      }

      function respectsCoordinatorAuthority() {
        return resource.data.get('coordinatorVersion', 0) != 1 ||
          isCoordinatorLobbyStart() ||
          isCoordinatorLobbyJoin() ||
          isOwnHeartbeatRenewal();
      }

      function hasValidPlayerCapacity() {
        return request.resource.data.players.size() <= 3 &&
          request.resource.data.get('playerIds', []).size() <= 3;
      }
      // Admin : accès complet
      allow read, write: if isAdmin();

      // Joueurs : création et lecture
      allow read, create: if request.auth != null;

      // Un joueur ne peut mettre à jour que s'il est dans la room (ou s'y ajoute)
      allow update: if isRoomMember() && respectsCoordinatorAuthority() && hasValidPlayerCapacity();

      // Seul le créateur (host) peut supprimer la room, OU la room est vide (plus de joueurs)
      allow delete: if request.auth != null && (request.auth.uid == resource.data.createdBy || resource.data.playerIds.size() == 0);
    }

    // Tournois : lecture publique (pour l'app mobile), écriture admin uniquement
    match /tournaments/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
      
      // Les joueurs peuvent écrire leur propre document participant (pour rejoindre)
      match /participants/{userId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Logs des actions admin : écriture par les admins authentifiés, lecture superadmin uniquement
    match /admin_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isAdmin();
      allow update, delete: if false; // Les logs sont immuables
    }

    // Logs système (Cloud Functions) : lecture superadmin uniquement.
    // Écriture réservée aux Cloud Functions via Admin SDK (qui bypasse les rules).
    match /system_logs/{logId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // Actualités (News) : Lecture pour tous, écriture pour les admins
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Publicités (Ads) — Phase 1 : popup admin-managed.
    // Lecture publique (mobile charge la liste au démarrage), écriture admin uniquement.
    match /ads/{adId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Campagnes informatives : lecture pour les joueurs, gestion réservée aux admins.
    match /campaigns/{campaignId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Messages et emojis du tchat en jeu.
    // Lecture authentifiée (mobile), écriture admin uniquement.
    match /chat_messages/{id} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Feedbacks utilisateurs (envoyés depuis le bouton MDC dans la sidebar)
    // Tout joueur authentifié peut créer un feedback. Lecture/modification superadmin uniquement.
    match /feedbacks/{feedbackId} {
      allow create: if request.auth != null;
      allow read: if isSuperAdmin();
      allow update: if isSuperAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readAt']);
      allow delete: if false;
    }

    // Configuration globale du jeu
    match /config/{docId} {
      allow read: if request.auth != null; // Lecture par tous (utile pour le mobile)
      allow write: if isSuperAdmin();
    }

    // Règle pour les profils utilisateurs
    match /users/{userId} {
      // Superadmin : accès complet (lecture + modification pour bannissement, coins, etc.)
      allow read, write: if isSuperAdmin();

      // Joueur : lecture de tous. Les coins sont désormais modifiés uniquement
      // par les Cloud Functions (Admin SDK). Les anciennes versions peuvent
      // encore mettre à jour les autres champs du profil sans réécrire le solde.
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == userId &&
        request.resource.data.get('economy', {}).get('coins', 300) == 300;
      allow update: if request.auth != null && request.auth.uid == userId &&
        (
          // Les statistiques sont écrites exclusivement par les Cloud Functions.
          // Les anciennes versions du mobile ne doivent plus pouvoir remplacer
          // un historique serveur avec leur cache local.
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['stats']) ||
            request.resource.data.stats.diff(resource.data.stats).affectedKeys().hasOnly(['inventory'])
          ) &&
          (
            !request.resource.data.get('economy', {}).diff(resource.data.get('economy', {})).affectedKeys().hasAny(['coins']) ||
            resource.data.get('coinAuthority', 'legacy') != 'server'
          )
        );
    }

    // Les droits Premium ne sont attribués que par les Cloud Functions.
    // Un joueur peut voir son statut, jamais s'en attribuer un.
    match /premium_entitlements/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Les mains et les reçus des replays ne sont accessibles que par les fonctions serveur.
    match /replay_libraries/{userId}/{document=**} {
      allow read, write: if false;
    }
    match /replay_candidates/{userId}/{document=**} {
      allow read, write: if false;
    }
    match /replay_sessions/{sessionId}/{document=**} {
      allow read, write: if false;
    }

    // Les codes ne doivent jamais être exposés aux clients. Leur consommation
    // est validée par une Cloud Function transactionnelle.
    match /premium_codes/{codeId} {
      allow read, write: if false;
    }

    match /premium_code_redemptions/{redemptionId} {
      allow read, write: if false;
    }

    // Règle pour les statistiques mensuelles des utilisateurs (leaderboard)
    match /users_monthly_stats/{statId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && 
        (resource == null 
          ? request.resource.data.userId == request.auth.uid 
          : (resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid));
    }

    // Projection légère maintenue exclusivement par Cloud Functions.
    match /users_global_stats/{statId} {
      allow read: if request.auth != null;
      allow write: if false;
    }
  }
}
