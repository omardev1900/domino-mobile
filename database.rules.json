{
  "rules": {
    ".read": false,
    ".write": false,
    "presence": {
      "$gameId": {
        ".read": "auth != null",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid",
          ".validate": "newData.hasChildren(['status', 't']) || newData.hasChildren(['connections'])",
          "status": {
            ".validate": "newData.isString() && (newData.val() === 'online' || newData.val() === 'offline')"
          },
          "t": {
            ".validate": "newData.isNumber()"
          },
          "connections": {
            "$connectionId": {
              ".validate": "newData.hasChildren(['status', 't'])",
              "status": {
                ".validate": "newData.isString() && newData.val() === 'online'"
              },
              "t": {
                ".validate": "newData.isNumber()"
              },
              "$other": {
                ".validate": false
              }
            }
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "matchmakingAvailability": {
      "public": {
        ".read": "auth != null",
        ".write": false,
        "availableCount": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        }
      },
      "connections": {
        "$uid": {
          ".read": false,
          "$connectionId": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.hasChildren(['t'])",
            "t": {
              ".validate": "newData.isNumber()"
            },
            "$other": {
              ".validate": false
            }
          }
        }
      },
      "availableUsers": {
        ".read": false,
        ".write": false
      }
    }
  }
}
